# Django
SECRET_KEY=mis-fasttrac-secret-key-2025-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=mis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Canvas LMS OAuth2 + API Token
# Get CANVAS_CLIENT_ID and CANVAS_CLIENT_SECRET from Canvas Admin > Developer Keys (OAuth app)
# Get CANVAS_API_TOKEN from Canvas Admin > Security > Approved Integrations (for server-to-server API calls)
# CANVAS_REDIRECT_URI must match the registered redirect in Canvas Developer Keys
CANVAS_BASE_URL=https://fasttrac.test.instructure.com
CANVAS_API_TOKEN=YOUR_CANVAS_API_TOKEN_HERE
CANVAS_CLIENT_ID=YOUR_OAUTH_CLIENT_ID_HERE
CANVAS_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET_HERE
CANVAS_REDIRECT_URI=http://localhost:8000/api/auth/canvas/callback/

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@fasttrac.local

# Public form captcha (Google reCAPTCHA v2 checkbox)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
